{
  "description": "Which optional features earn their place: every input feature and vocabulary option against plain words and fastText's subwords, at one table size. minCount 1000000000 disables word vectors.",
  "common": "-dim 64 -bucket 1048576 -loss softmax",
  "variants": [
    {
      "name": "words",
      "flags": "-minCount 1"
    },
    {
      "name": "words+bigrams",
      "flags": "-minCount 1 -wordNgrams 2"
    },
    {
      "name": "words+subwords",
      "flags": "-minCount 1 -minn 2 -maxn 5"
    },
    {
      "name": "bytes2-5",
      "flags": "-minCount 1000000000 -minb 2 -maxb 5"
    },
    {
      "name": "bytes2-5+words",
      "flags": "-minCount 1 -minb 2 -maxb 5"
    },
    {
      "name": "bytes2-5+words+bigrams",
      "flags": "-minCount 1 -minb 2 -maxb 5 -wordNgrams 2"
    },
    {
      "name": "chars1-4+words",
      "flags": "-minCount 1 -minc 1 -maxc 4"
    },
    {
      "name": "bytes2-5+words5",
      "flags": "-minCount 5 -minb 2 -maxb 5"
    },
    {
      "name": "bytes2-5+words+maxBytes512",
      "flags": "-minCount 1 -minb 2 -maxb 5 -maxBytes 512"
    },
    {
      "name": "words+subwords+maxVocab50k",
      "flags": "-minCount 1 -minn 2 -maxn 5 -maxVocab 50000"
    }
  ]
}
